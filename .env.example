# ---------------------------------------------------------------------------
# Next.js .env template (local development / `next build`).
#
# NEXT_PUBLIC_* values are inlined into the browser and server bundles at build
# time: set real production values in the build environment (for example the
# Workers Builds build variables), not only in the Worker runtime dashboard.
#
# Server-only values below are runtime configuration. For Cloudflare Workers,
# set them as Worker secrets/variables in the dashboard (or in `.dev.vars` for
# `pnpm preview`). Do NOT keep production server secrets in a `.env*` file that
# is present during `opennextjs-cloudflare build`: OpenNext compiles those files
# into the Worker bundle. See CLOUDFLARE_DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Public site config (safe to expose only where prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Defaults to "Metaract" (src/config/site.ts). Set it only to override the name.
NEXT_PUBLIC_STUDIO_NAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# MongoDB Atlas — server only, never use NEXT_PUBLIC_ prefix
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=digital_services_studio

# ---------------------------------------------------------------------------
# Agency email
#   AGENCY_EMAIL               -> From address on every outgoing email. Must be
#                                 the mailbox authenticated by GMAIL_USER below
#                                 (or a Gmail "send as" alias).
#   AGENCY_EMAIL_NAME          -> display name shown beside the address.
#   AGENCY_REPLY_TO            -> where customer replies go (defaults to
#                                 AGENCY_EMAIL when left empty).
#   AGENCY_NOTIFICATION_EMAIL  -> inbox that receives new-enquiry/team alerts.
#   AGENCY_BCC_EMAIL           -> optional blind-copy archive of every send.
# ---------------------------------------------------------------------------
AGENCY_EMAIL=
AGENCY_EMAIL_NAME=Metaract Studio
AGENCY_REPLY_TO=
AGENCY_NOTIFICATION_EMAIL=
AGENCY_BCC_EMAIL=

# Email provider (Gmail SMTP) — server only
EMAIL_PROVIDER=gmail

# Gmail SMTP credentials — required for real email; otherwise log-only mode.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Back-compat: still honored if set; AGENCY_EMAIL / AGENCY_NOTIFICATION_EMAIL win.
EMAIL_FROM=
INTERNAL_NOTIFICATION_EMAIL=

# Public contact email shown on the site (client-safe). Falls back to
# AGENCY_EMAIL when left empty.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Anti-abuse — server only
# ---------------------------------------------------------------------------
# Cloudflare Turnstile secret key. Real key required for production; dev bypass
# applies only when this is unset and NODE_ENV != production. (issue 4)
TURNSTILE_SECRET_KEY=

# Upstash Redis REST credentials for the enquiry rate limiter. Real URL + token
# required for production; otherwise the in-process memory fallback is used.
# (issue 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Admin bootstrap / operational policy — server only
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_ALLOWED=false
# Local operator sign-in fallback. Honored only when NODE_ENV != production,
# or in production when ALLOW_DEV_ADMIN=true (emergency use; not normal ops).
ALLOW_DEV_ADMIN=false
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Dev-only local admin fallback (used when MONGODB_URI is not configured)
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=
ENQUIRY_RETENTION_MONTHS=12
LOG_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# NODE_ENV is set automatically by Next.js (`development` for `next dev`,
# `production` for `next build`). Do not set it in .env files.
# ---------------------------------------------------------------------------
