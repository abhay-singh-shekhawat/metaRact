# ---------------------------------------------------------------------------
# Public site config (NEXT_PUBLIC_ values are baked into the client bundle)
# ---------------------------------------------------------------------------
# Production must be a canonical HTTPS origin, e.g. https://studio.example.com.
# Do NOT deploy with http://localhost:3000 — share links, sitemap, robots and
# Open Graph cards all derive from this value. Set it on your hosting platform.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Public studio name. Production preflight blocks launch while this is the placeholder.
NEXT_PUBLIC_STUDIO_NAME=Your Studio Name

# Public contact email shown on the contact page (issue 5). Leave blank to keep
# the honest empty state; the contact page then falls back to the project form.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public WhatsApp URL shown on the contact page (issue 5), e.g.
# https://wa.me/15551234567. Leave blank to omit WhatsApp from direct channels.
NEXT_PUBLIC_WHATSAPP_URL=

# Cloudflare Turnstile site key — embedded in the client. Get a real key from
# the Cloudflare dashboard. Dev mode works without it (bypass), production does not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# MongoDB Atlas — server only, never use NEXT_PUBLIC_ prefix
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=digital_services_studio

# ---------------------------------------------------------------------------
# Email provider (Gmail SMTP) — server only
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=gmail

# Gmail SMTP credentials — required for real email; otherwise log-only mode.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender and internal recipient
EMAIL_FROM=
INTERNAL_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Anti-abuse — server only
# ---------------------------------------------------------------------------
# Cloudflare Turnstile secret key. Real key required for production; dev bypass
# applies only when this is unset and NODE_ENV != production. (issue 4)
TURNSTILE_SECRET_KEY=

# Upstash Redis REST credentials for the enquiry rate limiter. Real URL + token
# required for production; otherwise the in-process memory fallback is used.
# (issue 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Admin bootstrap / operational policy — server only
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_ALLOWED=false
# Local operator sign-in fallback. Honored only when NODE_ENV != production,
# or in production when ALLOW_DEV_ADMIN=true (emergency use; not normal ops).
ALLOW_DEV_ADMIN=false
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Dev-only local admin fallback (used when MONGODB_URI is not configured)
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=
PRIVACY_NOTICE_VERSION=2026-10-01
ENQUIRY_RETENTION_MONTHS=12
LOG_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
NODE_ENV=development
