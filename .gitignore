# Local data & build output
.data/
.next/
out/
node_modules/
# OpenNext / Wrangler build output and local Worker state
.open-next/
.wrangler/
cloudflare-env.d.ts
worker-configuration.d.ts
test-results/
playwright-report/
tsconfig.tsbuildinfo
*.log
.DS_Store

# Environment & secrets — never commit real credentials.
# (.env.example is the tracked template; everything below stays local.)
.env
.env.local
.env*.local
!.env.example

# Cloudflare local Worker env (secrets for `pnpm preview`); template is tracked.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Certificates, keys & provider credential files
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
*-credentials.json
service-account*.json
secrets*.json
.npmrc
