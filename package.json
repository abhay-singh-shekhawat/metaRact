{
  "name": "digital-services-studio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy -- --keep-vars",
    "deploy:worker": "opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare upload -- --keep-vars",
    "upload:worker": "opennextjs-cloudflare upload -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:reset": "tsx scripts/db-reset.ts",
    "check:production-config": "tsx scripts/check-production-config.ts",
    "email:test": "tsx --conditions=react-server scripts/send-test-email.ts",
    "legal:import": "tsx scripts/import-legal.ts",
    "bootstrap-admin": "tsx --conditions=react-server scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^3.0.3",
    "lenis": "^1.3.27",
    "mongodb": "^7.7.0",
    "next": "15.5.28",
    "nodemailer": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "//": "sharp is an optional peer of Next. 0.35 ships a native loader that @opennextjs/cloudflare cannot bundle; 0.34.5 is within Next's supported range and builds cleanly. It is pinned even though next/image is unoptimized in the Worker, because Next still installs the optional package.",
    "overrides": {
      "sharp": "0.34.5"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.3"
  }
}
